{
  "manifest_version": 3,
  "name": "AI Virtual Try-On",
  "version": "1.0.0",
  "description": "Detect products on shopping websites and try them on virtually using AI.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Virtual Try-On"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}